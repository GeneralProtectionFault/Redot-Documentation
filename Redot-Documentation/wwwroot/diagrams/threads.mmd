sequenceDiagram  
    participant Main as "Main Thread (main/main.cpp)"  
    participant WTP as "WorkerThreadPool (worker_thread_pool.cpp)"  
    participant RT as "Render Thread (rendering_server_default.cpp)"  
    participant AT as "Audio Thread (audio_driver_wasapi/alsa/etc)"  
    participant P3D as "Physics 3D Thread (physics_server_3d_wrap_mt.cpp)"  
    participant P2D as "Physics 2D Thread (physics_server_2d_wrap_mt.cpp)"  
    participant WW as "WTP Worker Threads (navmesh / sub-thread nodes / resource loads)"  
    participant WayEvt as "Wayland Event Thread (wayland_thread.cpp - Linux/Wayland only)"  
    participant X11Evt as "X11 Event Thread (display_server_x11.cpp - Linux/X11 only)"  
    participant DbgTCP as "Debugger TCP Thread (remote_debugger_peer.cpp - remote debug only)"  
    participant IPRes as "IP DNS Resolver Thread (core/io/ip.cpp - always present)"  
    participant DBusMon as "DBus Portal Monitor Thread (freedesktop_portal_desktop.cpp - Linux/DBus)"  
    participant AtSPI as "AT-SPI Monitor Thread (freedesktop_at_spi_monitor.cpp - Linux/DBus)"  
    participant MIDI as "ALSA MIDI Thread (midi_driver_alsamidi.cpp - Linux/MIDI)"  
    participant WinFD as "Windows File Dialog Thread (display_server_windows.cpp - Windows per-dialog)"  
    participant CamMon as "Camera Device Monitor Thread (camera_linux.cpp - Linux/camera module)"  
    participant CamFeed as "Camera Feed Capture Thread (camera_feed_linux.cpp - Linux per-camera)"  
    participant AudioRec as "Audio Record I/O Thread (audio_effect_record.cpp - when recording)"  
    participant HTTP as "HTTPRequest Thread (http_request.cpp - per request when use_threads=true)"  
    participant NoiseTex as "NoiseTexture Gen Thread (noise_texture_2d/3d.cpp - per texture update)"  
  
